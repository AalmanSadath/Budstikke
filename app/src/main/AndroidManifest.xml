<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SMS only. No network access: the INTERNET permission is removed even if a
         library declares it, so Android blocks every socket the app could open. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Lists the active SIMs so a message can be sent on either. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Shows saved contacts' names and photos instead of bare numbers. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Sets alarms again after a restart: the trash clean-up and scheduled messages. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Scheduled messages go out on the minute. USE_EXACT_ALARM is granted on install from
         Android 13; Android 12 needs SCHEDULE_EXACT_ALARM, also granted there. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Locked messages: asks Android's own fingerprint, face or screen lock prompt to
         confirm it is the owner. The prompt is the system's; the app sees only the result. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="true" />

    <application
        android:name=".BudstikkeApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@android:drawable/sym_action_chat"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Budstikke">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The compose screen the SMS role requires: opened by sms: and smsto: links. -->
        <activity
            android:name=".ComposeActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
            </intent-filter>
        </activity>

        <!-- Incoming SMS, delivered only to the default SMS app. -->
        <receiver
            android:name=".sms.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- The SMS role is only granted to an app that also declares an MMS receiver.
             MMS is out of scope, so the push is dropped. -->
        <receiver
            android:name=".sms.MmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <!-- Sent and delivered results for outgoing SMS. Only this app's own
             PendingIntents reach it. -->
        <receiver
            android:name=".sms.SmsStatusReceiver"
            android:exported="false" />

        <!-- Reply and Mark as read on message notifications. -->
        <receiver
            android:name=".notify.NotificationActionReceiver"
            android:exported="false" />

        <!-- Empties trash older than 30 days once a day. Only the app's own alarm reaches it. -->
        <receiver
            android:name=".trash.TrashPurgeReceiver"
            android:exported="false" />

        <!-- Sends scheduled messages when their time comes. Only the app's own alarm
             reaches it. -->
        <receiver
            android:name=".sms.OutgoingReceiver"
            android:exported="false" />

        <!-- Restarts and updates clear alarms; this sets them again and sends scheduled
             messages that fell due while the phone was off. -->
        <receiver
            android:name=".system.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- "Reply with message" on an incoming call. -->
        <service
            android:name=".sms.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
            </intent-filter>
        </service>
    </application>
</manifest>
